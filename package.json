{
  "name": "appstore-forge",
  "private": true,
  "version": "1.1.0",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4324",
    "electron:dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite --port 4324\" \"wait-on tcp:127.0.0.1:4324 && VITE_DEV_SERVER_URL=http://localhost:4324 electron .\"",
    "build": "tsc -b && vite build",
    "app": "pnpm build && electron-builder --mac --arm64 --dir",
    "dist": "pnpm build && electron-builder --mac --arm64",
    "typecheck": "tsc -b --noEmit",
    "install:app": "pnpm dist && rm -rf \"/Applications/AppStore Forge.app\" && cp -R \"release/mac-arm64/AppStore Forge.app\" /Applications/ && open -a \"AppStore Forge\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fflate": "^0.8.2",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.11",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0",
    "zustand": "^5.0.3"
  },
  "productName": "AppStore Forge",
  "description": "Forge App Store and Google Play screenshots from raw app captures",
  "author": "Hebert Porto",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.hebertporto.appstoreforge",
    "productName": "AppStore Forge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null
    },
    "dmg": {
      "title": "AppStore Forge ${version}"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "license": "MIT",
  "homepage": "https://github.com/hebertporto/appstore-forge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebertporto/appstore-forge.git"
  },
  "bugs": {
    "url": "https://github.com/hebertporto/appstore-forge/issues"
  },
  "keywords": [
    "app-store",
    "google-play",
    "screenshots",
    "electron",
    "canvas",
    "marketing",
    "aso"
  ]
}
