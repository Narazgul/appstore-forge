{
  "name": "@narazgul/appstore-forge",
  "private": false,
  "version": "2.1.1",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "bin": {
    "forge": "./bin/forge.mjs"
  },
  "files": [
    "bin",
    "cli",
    "src",
    "fonts",
    "index.html",
    "vite.config.ts",
    "vite-plugin-project.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "vite --port 4324",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@napi-rs/canvas": "^0.1.80",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fflate": "^0.8.2",
    "pngjs": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "vite": "^6.0.11",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "homepage": "https://github.com/hebertporto/appstore-forge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebertporto/appstore-forge.git"
  },
  "bugs": {
    "url": "https://github.com/hebertporto/appstore-forge/issues"
  },
  "keywords": [
    "app-store",
    "google-play",
    "screenshots",
